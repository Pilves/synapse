<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample backup rules for Android 11 and below.
   Defines what data is backed up.
-->
<full-backup-content>
    <!-- Exclude all SharedPreferences (may contain API keys and tokens) -->
    <exclude domain="sharedpref" path="." />
    <!-- Exclude session files -->
    <exclude domain="file" path="sessions/" />
    <!-- Exclude databases -->
    <exclude domain="database" path="." />
</full-backup-content>
