<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules for Android 12+ backup.
   Defines what data is backed up to Google cloud.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all SharedPreferences (may contain API keys and tokens) -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude session files -->
        <exclude domain="file" path="sessions/" />
        <!-- Exclude sensitive data -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all SharedPreferences (may contain API keys and tokens) -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude session files -->
        <exclude domain="file" path="sessions/" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
