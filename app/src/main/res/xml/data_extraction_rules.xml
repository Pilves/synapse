<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ backup.
   Uses explicit inclusion to prevent accidental leakage of sensitive data.
   Only non-sensitive user preferences are backed up.
   Excluded: sessions/, chunks/, screenshots/, datastore/, projects/, sync/, keys.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Only back up non-sensitive shared preferences -->
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="synapse_secure_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="synapse_secure_keys.xml" />
    </device-transfer>
</data-extraction-rules>
